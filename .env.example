# Copy to .env only if you want to change a default. Every value below is also the default
# in the file that reads it, so a fresh clone works without a .env.
# Compose reads it via: docker compose --env-file .env -f deploy/compose.yaml up -d --wait
# Backend and Vite do not read .env themselves: run `set -a; . ./.env; set +a` first.

# --- Compose: network ---
# Interface the published ports bind to. Keep 127.0.0.1 so dev credentials stay off the LAN.
HOST_BIND=127.0.0.1

# --- Compose: PostgreSQL ---
# The image applies these only on first init; after changing them run
# `docker compose -f deploy/compose.yaml down -v`.
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow

# --- Compose: RabbitMQ ---
RABBITMQ_DEFAULT_USER=taskflow
RABBITMQ_DEFAULT_PASS=taskflow

# --- Compose: object storage (MinIO) ---
MINIO_ROOT_USER=taskflow
MINIO_ROOT_PASSWORD=taskflow-secret
