# Copy to .env only if you want to change a default. Every value below is also the default
# in the file that reads it, so a fresh clone works without a .env.
# Compose reads it via: docker compose --env-file .env -f deploy/compose.yaml up -d --wait
# Backend and Vite do not read .env themselves: run `set -a; . ./.env; set +a` first.

# --- Compose: network ---
# Interface the published ports bind to. Keep 127.0.0.1 so dev credentials stay off the LAN.
HOST_BIND=127.0.0.1

# --- Compose: PostgreSQL ---
# The image applies these only on first init; after changing them run
# `docker compose -f deploy/compose.yaml down -v`.
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow

# --- Backend: database connection (must match the POSTGRES_* values above) ---
TASKFLOW_DB_URL=jdbc:postgresql://localhost:5432/taskflow
TASKFLOW_DB_USER=taskflow
TASKFLOW_DB_PASSWORD=taskflow

# --- Backend: HTTP ---
TASKFLOW_PORT=8080

# --- Backend: authentication ---
# Signing secret for access tokens (HS256, at least 32 bytes). Unlike the other values it has NO
# default: the backend refuses to start without it, unless the `dev` profile is active
# (SPRING_PROFILES_ACTIVE=dev), which supplies a development-only value.
# Generate one with: openssl rand -base64 48
# TASKFLOW_JWT_SECRET=<generated value>

# --- Backend: Redis (rate limiting); matches the Compose redis service ---
TASKFLOW_REDIS_HOST=localhost
TASKFLOW_REDIS_PORT=6379

# --- Backend: SMTP for invite mail; matches the Compose mailpit service (UI on :8025) ---
TASKFLOW_MAIL_HOST=localhost
TASKFLOW_MAIL_PORT=1025

# --- Backend: public base URL of the web app, used to build invite links ---
TASKFLOW_APP_URL=http://localhost:5173

# --- Compose: RabbitMQ ---
RABBITMQ_DEFAULT_USER=taskflow
RABBITMQ_DEFAULT_PASS=taskflow

# --- Compose: object storage (MinIO) ---
MINIO_ROOT_USER=taskflow
MINIO_ROOT_PASSWORD=taskflow-secret

# --- Frontend (Vite dev server) ---
# Where the dev server proxies /api. The browser itself always calls relative /api URLs.
VITE_API_PROXY_TARGET=http://localhost:8080

# --- Demo data (scripts/seed/demo.mjs) ---
# The API the seed script talks to (the Vite dev server proxies /api; use the backend URL to skip it)
# and the Mailpit HTTP API it reads invite mail from.
SEED_API_URL=http://localhost:5173
SEED_MAILPIT_URL=http://localhost:8025
# e2e (Playwright) reads the invite mail from here as well.
E2E_MAILPIT_URL=http://localhost:8025
